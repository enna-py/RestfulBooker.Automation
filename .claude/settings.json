{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(dotnet test *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/detect-dotnet-test-run.js\"",
            "timeout": 15,
            "statusMessage": "Checking for correlated trx/NUnit XML artifacts..."
          }
        ]
      }
    ]
  }
}
